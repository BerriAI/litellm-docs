    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=8.3.0"
  },
  "overrides": {
