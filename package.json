    "check:rust-migration-releases": "node scripts/update-rust-migration-releases.mjs --check",
    "lint:writing": "node scripts/check-writing-style.js docs blog release_notes",
    "lint:docs": "python3 scripts/check-docs.py docs",
    "test:search": "node --no-experimental-require-module --test search/*.test.js",
    "search:serve": "node search/server.js",
    "search:verify-trace": "node search/verify-trace.js",
    "generate:social-card": "node scripts/social-card/index.cjs",
    "test:social-cards": "node --test scripts/social-card/social-cards.test.cjs",
    "test:optimize-images": "node --test plugins/optimize-images.test.cjs",
    "sync:lens": "node scripts/sync-lens-docs.mjs",
    "test:lens": "node --test scripts/sync-lens-docs.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
