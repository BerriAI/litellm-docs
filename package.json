    "cheerio": "1.0.0-rc.12",
    "clsx": "2.1.1",
    "lucide-react": "^0.503.0",
    "mdast-util-from-markdown": "2.0.2",
    "minisearch": "7.2.0",
    "posthog-docusaurus": "^2.0.5",
    "prism-react-renderer": "1.3.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "react-vega": "^8.0.0",
    "remark-gfm": "4.0.1",
    "semver": "^7.8.5",
    "sharp": "0.32.6",
