# Legacy gateway for the existing bot and local Jev lab.
# Website Ask AI uses the paired gateway variables below.
# DOCS_AI_API_KEY=your-dedicated-docs-virtual-key
# DOCS_AI_BASE_URL=https://gateway.example.com/v1

# Server-only inference configuration. Set the actual HTTPS gateway URL at runtime.
LITELLM_PROXY_API_BASE=https://gateway.example.com/v1
LITELLM_PROXY_API_KEY=your-dedicated-docs-virtual-key
# Required as a pair when the gateway uses Cloudflare Access service authentication.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# Public deployments also require DOCS_AI_PUBLIC_ENABLED=true
# DOCS_ORIGIN=https://docs.example.com

# Keep existing bot settings when moving website Ask AI to another gateway.
# Set these only when configuring or moving the authenticated bot separately.
# DOCS_BOT_SERVICE_TOKEN=your-bot-service-token
# DOCS_BOT_AI_API_KEY=your-dedicated-bot-virtual-key
# DOCS_BOT_AI_BASE_URL=https://bot-gateway.example.com/v1
# DOCS_BOT_CF_ACCESS_CLIENT_ID=
# DOCS_BOT_CF_ACCESS_CLIENT_SECRET=

# Workshop signup relay. Configure this server-only in Vercel; never expose it
# through Docusaurus customFields or a client-side environment variable.
# WORKSHOP_ZAPIER_WEBHOOK_URL=

# Optional: send Ask AI traces directly to standalone Lens.
# Copy a dedicated ingestion key from Lens Home > Tracing key.
# LITELLM_TRACING_KEY=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://your-lens.example.com/v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# LENS_UI_URL=https://your-lens.example.com/ui/
# Optional dedicated tracing key for the authenticated Slack bot route.
# Uses the same Lens endpoint and agent name as website Ask AI.
# DOCS_BOT_TRACING_KEY=
